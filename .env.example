# --- Reasoning LLM provider ---
# groq (recommended: open-source models, hosted, fast) | ollama (fully local, no API key)
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Model used by the Business-Logic agent (needs strong code reasoning)
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# Model used by the Planner agent (attack chain composition)
GROQ_PLANNER_MODEL=llama-3.3-70b-versatile

# Only used when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- GitHub App (Connect stage: clone private repos, open Issues/PRs as the app) ---
# Create an app at https://github.com/settings/apps/new
# Permissions needed: Contents (Read), Issues (Read/Write), Pull requests (Read/Write), Metadata (Read)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=./github-app-private-key.pem
GITHUB_APP_INSTALLATION_ID=

# Fallback: a classic/fine-grained Personal Access Token, used if no GitHub App is configured.
# Useful for quick local testing against public repos without registering an App.
GITHUB_TOKEN=

# --- Verify stage ---
# Max concurrent requests fired when dynamically verifying a race-condition chain
VERIFY_RACE_CONCURRENCY=200
# Seconds to wait for a target app to boot before attempting dynamic verification
VERIFY_BOOT_TIMEOUT_SECONDS=25
